# ==============================================================================
# 「二楼有请 / Lemon 2F」影视众包入库与软妹币管理系统 - 环境配置文件示例
# ==============================================================================

# 基础与安全设置 (生产环境必须替换为高强度随机密钥)
APP_NAME="二楼有请 (Lemon 2F)"
APP_ENV=production
SECRET_KEY=generate_a_strong_random_secret_string_for_production_security

# CORS 跨域白名单 (逗号分隔，生产环境必填且严禁使用 *)
# 因为服务端开启了 allow_credentials=True，通配来源等于允许任意站点
# 携带用户 JWT 发起跨站请求。留空或填 * 会在生产启动时被直接拦截。
CORS_ALLOW_ORIGINS=https://2f.yourdomain.com,https://emby.yourdomain.com

# 数据库与缓存配置
# 生产环境推荐使用 Compose 自带 PostgreSQL (无需修改):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_strong_password
POSTGRES_DB=lemon_2f

# Emby 媒体服务器配置 (生产环境必须配置)
EMBY_SERVER_URL=http://your-emby-host:8096
EMBY_API_KEY=your_emby_admin_api_key_here
EMBY_PUBLIC_URL=https://emby.yourdomain.com

# TMDB 权威刮削配置 (生产环境必须配置)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_LANGUAGE=zh-CN

# qBittorrent 下载客户端配置
QB_HOST=http://your-qb-host:8080
QB_USERNAME=admin
QB_PASSWORD=your_qb_password
QB_CATEGORY=lemon_2f

# 路径映射配置 (区分宿主机物理真实路径与容器内部挂载路径)
# 宿主机物理路径 (左侧挂载点):
QB_HOST_DOWNLOAD_PATH=/opt/pt/downloads/lemon_2f
MEDIA_MOVIES_HOST_PATH=/opt/media/movies
MEDIA_TV_HOST_PATH=/opt/media/tv

# 交付模式与冲突策略
# DELIVERY_ADAPTER: local (唯一已实装；配置其他值会 Fail-Closed 拒绝启动)
# DELIVERY_MODE:    hardlink | copy | move
#   hardlink 跨文件系统时自动降级为 copy
# FILE_CONFLICT_STRATEGY: SKIP | REPLACE | KEEP_BOTH
DELIVERY_ADAPTER=local
DELIVERY_MODE=hardlink
FILE_CONFLICT_STRATEGY=SKIP

# 风控与熔断阈值
# 注意：下载/媒体挂载点缺失时系统一律 Fail-Closed 判死，
# 绝不会回退到容器本地层落盘（那会导致 Emby 扫不到且重启即丢）。
MIN_VIDEO_DURATION_SECONDS=30
MIN_DISK_FREE_PERCENT=10
DEAD_TORRENT_TIMEOUT_MINUTES=15
EMBY_CONFIRM_TIMEOUT_MINUTES=30
RESERVATION_TTL_MINUTES=120

# 流水线调度：事件驱动为主 + 轮询兜底。
# qB 完成回调会立即唤醒 Worker（实测唤醒延迟 ~0.3s），
# 这两个间隔只是没有事件时的兜底节拍。
# 注意：数值不得超过 RedisManager.MAX_BLOCKING_WAIT_SECONDS(300)，否则会被钳制。
PIPELINE_POLL_INTERVAL_SECONDS=15
PIPELINE_IDLE_INTERVAL_SECONDS=60

# qBittorrent 下载完成 Webhook 共享密钥（强随机字符串）。
# 留空则 Webhook 端点一律拒绝（Fail-Closed），退化为纯轮询。
# 在 qBittorrent 中配置：设置 -> 下载 -> Torrent 完成时运行外部程序：
#   curl -s -X POST "http://lemon-2f:8000/api/webhooks/qb/complete?torrent_hash=%I" \
#        -H "X-Lemon-Webhook-Token: <此处的值>"
QB_WEBHOOK_TOKEN=generate_a_strong_random_webhook_token

# 软妹币经济系统分值规则
INITIAL_USER_COINS=100
SIGN_IN_MIN_COINS=5
SIGN_IN_MAX_COINS=20
MOVIE_UPLOAD_REWARD=60
EPISODE_UPLOAD_REWARD=20
RESOLUTION_4K_BONUS=30

# Telegram 运维 Bot (可选)
# 注意：Bot 不再按 Telegram ID 自动建号发币。
# 用户必须先在 Bot 中 /link 取绑定码，再到 Web 端用 Emby 账号登录后提交绑定，
# Emby 账号是唯一权威身份，Telegram 只是它的一个接入端。
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_ADMIN_IDS=[123456789]
