# LemonEmos 基础配置
APP_NAME=LemonEmos
APP_ENV=production
SECRET_KEY=lemon_emos_change_me_in_production_jwt_key

# Emby / Foam 核心接入
EMBY_SERVER_URL=https://your-emby-server.com
EMBY_API_KEY=your_emby_admin_api_key_here
FOAM_API_URL=
FOAM_API_TOKEN=

# TMDB 刮削配置
TMDB_API_KEY=15d2ea6d0dc1d476efbca3eba2b9bbfb

# qBittorrent 离线下载器
QB_HOST=127.0.0.1
QB_PORT=8999
QB_USERNAME=admin
QB_PASSWORD=your_qb_password
QB_SAVE_PATH=/downloads
EMBY_MEDIA_PATH=/media

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_IDS=7996620779
TELEGRAM_OWNER_ID=7996620779

# Redis
REDIS_URL=redis://lemon-redis:6379/0

# 积分经济分值
POINTS_NEW_MOVIE=5.0
POINTS_EPISODE=1.0
POINTS_4K_UPGRADE=3.0
POINTS_PENALTY_FRAUD=10.0
