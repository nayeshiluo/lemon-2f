# ==============================================================================
# 「二楼有请 / Lemon 2F」影视众包入库与二楼币管理系统 - 环境配置文件示例
# ==============================================================================

# 基础与安全设置 (生产环境必须替换为高强度随机密钥)
APP_NAME="二楼有请 (Lemon 2F)"
APP_ENV=production
SECRET_KEY=generate_a_strong_random_secret_string_for_production_security

# 数据库与缓存配置
# 生产环境推荐使用 Compose 自带 PostgreSQL (无需修改):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_strong_password
POSTGRES_DB=lemon_2f

# Emby 媒体服务器配置 (生产环境必须配置)
EMBY_SERVER_URL=http://your-emby-host:8096
EMBY_API_KEY=your_emby_admin_api_key_here
EMBY_PUBLIC_URL=https://emby.yourdomain.com

# TMDB 权威刮削配置 (生产环境必须配置)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_LANGUAGE=zh-CN

# qBittorrent 下载客户端配置
QB_HOST=http://your-qb-host:8080
QB_USERNAME=admin
QB_PASSWORD=your_qb_password
QB_CATEGORY=lemon_2f

# 路径映射配置 (区分宿主机物理真实路径与容器内部挂载路径)
# 宿主机物理路径 (左侧挂载点):
QB_HOST_DOWNLOAD_PATH=/opt/pt/downloads/lemon_2f
MEDIA_MOVIES_HOST_PATH=/opt/media/movies
MEDIA_TV_HOST_PATH=/opt/media/tv

# 交付模式与冲突策略
DELIVERY_ADAPTER=local
DELIVERY_MODE=hardlink
FILE_CONFLICT_STRATEGY=SKIP

# 二楼币经济系统分值规则
INITIAL_USER_COINS=100
SIGN_IN_MIN_COINS=5
SIGN_IN_MAX_COINS=20
MOVIE_UPLOAD_REWARD=60
EPISODE_UPLOAD_REWARD=20
RESOLUTION_4K_BONUS=30

# Telegram 运维 Bot (可选)
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_ADMIN_IDS=[123456789]
